--- !u!114 &1353232760388304956
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4580751691503761795}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_TGK
  labelKey: CometTgkLabel
  descriptionEnglish: "41P/Tuttle\u2013Giacobini\u2013Kres\xE1k is a compact Jupiter-family
    comet orbiting about every 5.4 years. Its nucleus is irregular and dark, rich
    in dust.\n\nNear the Sun the coma expands into a soft glowing halo. Dust forms
    a broad curved tail; ionized gas produces a narrow blue ray aimed away from the
    Sun.\n\nBeyond the outer planets only the nucleus is detectable as a dim dot."
  descriptionRussian: "41P/TGK (\u0422\u0443\u0442\u0442\u043B\u044C\u2014\u0414\u0436\u0438\u0430\u043A\u043E\u0431\u0438\u043D\u0438\u2014\u041A\u0440\u0435\u0441\u0430\u043A)
    \u2014 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0430\u044F \u043A\u043E\u043C\u0435\u0442\u0430
    \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u042E\u043F\u0438\u0442\u0435\u0440\u0430
    \u0441 \u043F\u0435\u0440\u0438\u043E\u0434\u043E\u043C \u043E\u043A\u043E\u043B\u043E
    5,4 \u0433\u043E\u0434\u0430. \u042F\u0434\u0440\u043E \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u0442\u0451\u043C\u043D\u043E\u0435, \u0431\u043E\u0433\u0430\u0442\u043E\u0435
    \u043F\u044B\u043B\u044C\u044E.\n\n\u0423 \u0421\u043E\u043B\u043D\u0446\u0430
    \u043A\u043E\u043C\u0430 \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442\u0441\u044F
    \u0432 \u043C\u044F\u0433\u043A\u043E\u0435 \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435.
    \u041F\u044B\u043B\u044C \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u0448\u0438\u0440\u043E\u043A\u0438\u0439
    \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u044B\u0439 \u0445\u0432\u043E\u0441\u0442;
    \u0438\u043E\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0433\u0430\u0437 \u2014 \u0443\u0437\u043A\u0438\u0439 \u0433\u043E\u043B\u0443\u0431\u043E\u0439
    \u043B\u0443\u0447 \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430.\n\n\u0417\u0430
    \u0432\u043D\u0435\u0448\u043D\u0438\u043C\u0438 \u043F\u043B\u0430\u043D\u0435\u0442\u0430\u043C\u0438
    \u0432\u0438\u0434\u043D\u0430 \u043B\u0438\u0448\u044C \u0442\u0443\u0441\u043A\u043B\u0430\u044F
    \u0442\u043E\u0447\u043A\u0430 \u044F\u0434\u0440\u0430."
  descriptionChinese: "41P/TGK\u662F\u7D27\u51D1\u7684\u6728\u661F\u65CF\u5F57\u661F\uFF0C\u5468\u671F\u7EA65.4\u5E74\u3002\u6838\u4E0D\u89C4\u5219\u3001\u5BCC\u542B\u5C18\u57C3\u3002\n\n\u8FD1\u592A\u9633\u65F6\u5F57\u53D1\u5448\u67D4\u548C\u5149\u6655\uFF1B\u5C18\u57C3\u5C3E\u5BBD\u800C\u5F2F\u66F2\uFF0C\u79BB\u5B50\u6C14\u4F53\u5F62\u6210\u80CC\u79BB\u592A\u9633\u7684\u84DD\u8272\u7EC6\u675F\u3002\n\n\u5728\u5916\u884C\u661F\u4E4B\u5916\u4EC5\u4E3A\u6697\u6DE1\u5149\u70B9\u3002"
  descriptionVietnamese: "41P/TGK l\xE0 sao ch\u1ED5i nh\u1ECF g\u1ECDn, chu k\u1EF3
    ~5,4 n\u0103m, h\u1EA1t nh\xE2n gi\xE0u b\u1EE5i.\n\nComa ph\xE1t s\xE1ng m\u1EC1m;
    \u0111u\xF4i b\u1EE5i r\u1ED9ng v\xE0 tia ion xanh.\n\nXa c\xE1c h\xE0nh tinh
    ngo\xE0i ch\u1EC9 l\xE0 ch\u1EA5m m\u1EDD."
  descriptionUzbek: "41P/TGK \u2014 ixcham Yupiter kometasi, ~5,4 yil. Changga boy
    yadro.\n\nQuyosh yaqinida yumshoq koma va keng chang dum.\n\nTashqi sayyoralar
    ortida xira nuqta."
