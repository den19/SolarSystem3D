--- !u!114 &4142335137912378399
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1917183381662294252}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_DArrest
  labelKey: CometDArrestLabel
  descriptionEnglish: '6P/d''Arrest is a classic short-period comet (about 6.5 years)
    named after its discoverer. The nucleus is a dark icy mass a few kilometres long.


    Solar
    ultraviolet drives gas outflows that glow in the coma. Dust trails curve along
    the orbit; ionized carbon monoxide forms a straight bluish tail.


    Beyond
    Jupiter d''Arrest is a faint stellar point without tails.'
  descriptionRussian: "6P/d'Arrest \u2014 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u043E\u043C\u0435\u0442\u0430 (\u043E\u043A\u043E\u043B\u043E 6,5 \u043B\u0435\u0442).
    \u042F\u0434\u0440\u043E \u2014 \u0442\u0451\u043C\u043D\u0430\u044F \u043B\u0435\u0434\u044F\u043D\u0430\u044F
    \u0433\u043B\u044B\u0431\u0430 \u0434\u043B\u0438\u043D\u043E\u0439 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u043E\u0432.\n\n\u0423\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442
    \u0421\u043E\u043B\u043D\u0446\u0430 \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u0435\u0442
    \u0433\u0430\u0437\u044B \u0432 \u0441\u0432\u0435\u0442\u044F\u0449\u0435\u0439\u0441\u044F
    \u043A\u043E\u043C\u0435. \u041F\u044B\u043B\u044C \u0438\u0437\u0433\u0438\u0431\u0430\u0435\u0442\u0441\u044F
    \u0432\u0434\u043E\u043B\u044C \u043E\u0440\u0431\u0438\u0442\u044B; \u0438\u043E\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    CO \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u043F\u0440\u044F\u043C\u043E\u0439
    \u0433\u043E\u043B\u0443\u0431\u043E\u0439 \u0445\u0432\u043E\u0441\u0442.\n\n\u0417\u0430
    \u042E\u043F\u0438\u0442\u0435\u0440\u043E\u043C \u2014 \u0441\u043B\u0430\u0431\u0430\u044F
    \u0437\u0432\u0451\u0437\u0434\u043D\u0430\u044F \u0442\u043E\u0447\u043A\u0430
    \u0431\u0435\u0437 \u0445\u0432\u043E\u0441\u0442\u043E\u0432."
  descriptionChinese: "6P/d'Arrest\u662F\u7ECF\u5178\u77ED\u5468\u671F\u5F57\u661F\uFF0C\u5468\u671F\u7EA66.5\u5E74\u3002\u6838\u4E3A\u51E0\u5343\u7C73\u957F\u7684\u6697\u51B0\u4F53\u3002\n\n\u7D2B\u5916\u8F90\u5C04\u9A71\u52A8\u5F57\u53D1\uFF1B\u5C18\u57C3\u6CBF\u8F68\u9053\u5F2F\u66F2\uFF0C\u7535\u79BB\u6C14\u4F53\u5F62\u6210\u84DD\u8272\u76F4\u5C3E\u3002\n\n\u6728\u661F\u5916\u4E3A\u65E0\u5C3E\u6697\u5F31\u661F\u70B9\u3002"
  descriptionVietnamese: "6P/d'Arrest chu k\u1EF3 ~6,5 n\u0103m, h\u1EA1t nh\xE2n
    b\u0103ng t\u1ED1i v\xE0i km.\n\nTia UV t\u1EA1o coma; \u0111u\xF4i b\u1EE5i
    cong, ion th\u1EB3ng m\xE0u xanh.\n\nNgo\xE0i Sao M\u1ED9c kh\xF4ng c\xF3 \u0111u\xF4i."
  descriptionUzbek: "6P/d'Arrest \u2014 klassik qisqa davrli komet, ~6,5 yil. Bir
    necha km muzli yadro.\n\nUV komani kuchaytiradi; chang dum egri, ion dum to\u02BBg\u02BBri.\n\nYupiter
    ortida dumsiz xira nuqta."
