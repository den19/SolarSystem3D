--- !u!114 &1611726283356070391
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4049447598311127295}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_Howell
  labelKey: CometHowellLabel
  descriptionEnglish: '88P/Howell is a medium-period comet orbiting every 5.5 years.
    Its nucleus is a dark icy body a few kilometres across with moderate activity.


    The
    coma glows pale green near the Sun; dust forms a gentle curved tail while ions
    stream away in a blue lance.


    Beyond Jupiter Howell is visible only as a
    faint moving point.'
  descriptionRussian: "88P/Howell \u2014 \u043A\u043E\u043C\u0435\u0442\u0430 \u0441\u043E
    \u0441\u0440\u0435\u0434\u043D\u0438\u043C \u043F\u0435\u0440\u0438\u043E\u0434\u043E\u043C
    \u043E\u043A\u043E\u043B\u043E 5,5 \u043B\u0435\u0442. \u042F\u0434\u0440\u043E
    \u2014 \u0442\u0451\u043C\u043D\u043E\u0435 \u043B\u0435\u0434\u044F\u043D\u043E\u0435
    \u0442\u0435\u043B\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u043E\u0432 \u0441 \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E.\n\n\u041A\u043E\u043C\u0430
    \u0431\u043B\u0435\u0434\u043D\u043E-\u0437\u0435\u043B\u0451\u043D\u0430\u044F
    \u0443 \u0421\u043E\u043B\u043D\u0446\u0430; \u043F\u044B\u043B\u044C \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u043F\u043B\u0430\u0432\u043D\u044B\u0439 \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u044B\u0439
    \u0445\u0432\u043E\u0441\u0442, \u0438\u043E\u043D\u044B \u2014 \u0433\u043E\u043B\u0443\u0431\u043E\u0435
    \u043A\u043E\u043F\u044C\u0451 \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430.\n\n\u0417\u0430
    \u042E\u043F\u0438\u0442\u0435\u0440\u043E\u043C \u0432\u0438\u0434\u043D\u0430
    \u043B\u0438\u0448\u044C \u043A\u0430\u043A \u0441\u043B\u0430\u0431\u0430\u044F
    \u0434\u0432\u0438\u0436\u0443\u0449\u0430\u044F\u0441\u044F \u0442\u043E\u0447\u043A\u0430."
  descriptionChinese: "88P/\u8C6A\u5A01\u5C14\u5468\u671F\u7EA65.5\u5E74\uFF0C\u6838\u4E3A\u51E0\u5343\u7C73\u6697\u51B0\u4F53\uFF0C\u6D3B\u52A8\u4E2D\u7B49\u3002\n\n\u8FD1\u592A\u9633\u6DE1\u7EFF\u8272\u5F57\u53D1\uFF1B\u5C18\u57C3\u5C3E\u5F2F\u66F2\uFF0C\u79BB\u5B50\u5C3E\u5448\u84DD\u8272\u957F\u675F\u3002\n\n\u6728\u661F\u5916\u4EC5\u4E3A\u5FAE\u5F31\u79FB\u52A8\u70B9\u3002"
  descriptionVietnamese: "88P/Howell chu k\u1EF3 ~5,5 n\u0103m, h\u1EA1t nh\xE2n
    b\u0103ng v\xE0i km.\n\nComa xanh nh\u1EA1t; \u0111u\xF4i b\u1EE5i cong, ion
    xanh.\n\nNgo\xE0i Sao M\u1ED9c ch\u1EC9 l\xE0 \u0111i\u1EC3m m\u1EDD."
  descriptionUzbek: "88P/Howell \u2014 ~5,5 yil, bir necha km muzli yadro.\n\nOch
    yashil koma; egri chang va ko\u02BBk ion dum.\n\nYupiter ortida xira harakatlanuvchi
    nuqta."
