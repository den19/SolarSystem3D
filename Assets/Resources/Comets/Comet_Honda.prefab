--- !u!114 &8566588458468904383
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6695453140112441762}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_Honda
  labelKey: CometHondaMrkosPajdusakovaLabel
  descriptionEnglish: "45P/Honda\u2013Mrkos\u2013Pajdu\u0161\xE1kov\xE1 is a Jupiter-family
    comet with a period near 5.3 years. Its nucleus is a small dark icy body, typically
    a few kilometres across.\n\nWhen solar heat awakens the comet, a diffuse coma
    glows greenish-blue from fluorescing gases. A dust tail curves behind along the
    path; an ion tail streams antisunward in pale blue.\n\nDistant from the Sun it
    appears as a faint stellar point. Activity rises sharply near perihelion."
  descriptionRussian: "45P/\u0425\u043E\u043D\u0434\u0430\u2014\u041C\u0440\u043A\u043E\u0441\u2014\u041F\u0430\u0439\u0434\u0443\u0448\u0430\u043A\u043E\u0432\u0430
    \u2014 \u043A\u043E\u043C\u0435\u0442\u0430 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430
    \u042E\u043F\u0438\u0442\u0435\u0440\u0430 \u0441 \u043F\u0435\u0440\u0438\u043E\u0434\u043E\u043C
    \u043E\u043A\u043E\u043B\u043E 5,3 \u0433\u043E\u0434\u0430. \u042F\u0434\u0440\u043E
    \u2014 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0442\u0451\u043C\u043D\u043E\u0435
    \u043B\u0435\u0434\u044F\u043D\u043E\u0435 \u0442\u0435\u043B\u043E \u0434\u043B\u0438\u043D\u043E\u0439
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u043E\u0432.\n\n\u041F\u043E\u0434\u043E\u0433\u0440\u0435\u0432
    \u0421\u043E\u043B\u043D\u0446\u0435\u043C \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
    \u0440\u0430\u0437\u043C\u044B\u0442\u0443\u044E \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u043E-\u0433\u043E\u043B\u0443\u0431\u0443\u044E
    \u043A\u043E\u043C\u0443. \u041F\u044B\u043B\u0435\u0432\u043E\u0439 \u0445\u0432\u043E\u0441\u0442
    \u0438\u0437\u0433\u0438\u0431\u0430\u0435\u0442\u0441\u044F \u0432\u0434\u043E\u043B\u044C
    \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438; \u0438\u043E\u043D\u043D\u044B\u0439
    \u2014 \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430
    \u0433\u043E\u043B\u0443\u0431\u043E\u0439 \u0441\u0442\u0440\u0443\u0451\u0439.\n\n\u0412\u0434\u0430\u043B\u0438
    \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430 \u2014 \u0441\u043B\u0430\u0431\u0430\u044F
    \u0437\u0432\u0451\u0437\u0434\u043D\u0430\u044F \u0442\u043E\u0447\u043A\u0430.
    \u0423 \u043F\u0435\u0440\u0438\u0433\u0435\u043B\u0438\u044F \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0440\u0435\u0437\u043A\u043E \u0440\u0430\u0441\u0442\u0451\u0442."
  descriptionChinese: "45P/\u672C\u7530\u2014\u9A6C\u5C14\u79D1\u65AF\u2014\u5E15\u675C\u4EC0\u79D1\u5A03\u662F\u6728\u661F\u65CF\u5F57\u661F\uFF0C\u5468\u671F\u7EA65.3\u5E74\u3002\u6838\u4E3A\u51E0\u5343\u7C73\u957F\u7684\u6697\u8272\u51B0\u4F53\u3002\n\n\u53D7\u592A\u9633\u52A0\u70ED\u5F62\u6210\u9752\u7EFF\u8272\u5F57\u53D1\uFF1B\u5C18\u57C3\u5C3E\u6CBF\u8F68\u9053\u5F2F\u66F2\uFF0C\u79BB\u5B50\u5C3E\u5448\u6DE1\u84DD\u8272\u80CC\u79BB\u592A\u9633\u3002\n\n\u8FDC\u79BB\u592A\u9633\u65F6\u4EC5\u4E3A\u5FAE\u5F31\u5149\u70B9\uFF1B\u8FC7\u8FD1\u65E5\u70B9\u6D3B\u52A8\u5267\u589E\u3002"
  descriptionVietnamese: "45P/Honda\u2013Mrkos\u2013Pajdu\u0161\xE1kov\xE1 thu\u1ED9c
    h\u1ECD Sao M\u1ED9c, chu k\u1EF3 ~5,3 n\u0103m. H\u1EA1t nh\xE2n b\u0103ng t\u1ED1i
    v\xE0i km.\n\nComa xanh l\u1EE5c, \u0111u\xF4i b\u1EE5i cong v\xE0 \u0111u\xF4i
    ion xanh h\u01B0\u1EDBng xa M\u1EB7t Tr\u1EDDi.\n\nXa M\u1EB7t Tr\u1EDDi ch\u1EC9
    l\xE0 ch\u1EA5m m\u1EDD; g\u1EA7n c\u1EADn nh\u1EADt r\u1EA5t s\xE1ng."
  descriptionUzbek: "45P/Honda\u2013Mrkos\u2013Pajdu\u0161\xE1kov\xE1 \u2014 Yupiter
    oilasidagi komet, davri ~5,3 yil. Bir necha kilometrli qorong\u02BBi muzli yadro.\n\nYashil-ko\u02BBk
    koma va ikki dum: chang va ion.\n\nUzoqda xira nuqta; perigeliyda faollashadi."
