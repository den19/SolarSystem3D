--- !u!114 &4885900462602328773
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7174518011366645455}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_Wirtanen
  labelKey: CometWirtanenLabel
  descriptionEnglish: "46P/Wirtanen is a small hyperactive comet that passes unusually
    close to Earth at times. Its nucleus is about 1.2 km across \u2014 bright for
    its size.\n\nNear perihelion the coma can grow very large relative to the nucleus.
    Dust and ion tails become clearly visible even in modest telescopes.\n\nFar from
    the Sun Wirtanen is a compact faint smudge."
  descriptionRussian: "46P/\u0412\u0438\u0440\u0442\u0430\u043D\u0435\u043D \u2014
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \xAB\u0433\u0438\u043F\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u0430\u044F\xBB
    \u043A\u043E\u043C\u0435\u0442\u0430, \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0430\u044F
    \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E \u0431\u043B\u0438\u0437\u043A\u043E
    \u043A \u0417\u0435\u043C\u043B\u0435. \u042F\u0434\u0440\u043E \u043E\u043A\u043E\u043B\u043E
    1,2 \u043A\u043C \u2014 \u044F\u0440\u043A\u043E\u0435 \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0433\u043E
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430.\n\n\u0423 \u043F\u0435\u0440\u0438\u0433\u0435\u043B\u0438\u044F
    \u043A\u043E\u043C\u0430 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
    \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u044F\u0434\u0440\u0430. \u041F\u044B\u043B\u0435\u0432\u043E\u0439 \u0438 \u0438\u043E\u043D\u043D\u044B\u0439
    \u0445\u0432\u043E\u0441\u0442\u044B \u0432\u0438\u0434\u043D\u044B \u0434\u0430\u0436\u0435
    \u0432 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0435 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u044B.\n\n\u0412\u0434\u0430\u043B\u0438
    \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430 \u2014 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u043E\u0435
    \u0442\u0443\u0441\u043A\u043B\u043E\u0435 \u043F\u044F\u0442\u043D\u043E."
  descriptionChinese: "46P/\u7EF4\u5C14\u7279\u5B81\u662F\u5C0F\u578B\u9AD8\u6D3B\u8DC3\u5F57\u661F\uFF0C\u6709\u65F6\u975E\u5E38\u63A5\u8FD1\u5730\u7403\u3002\u6838\u7EA61.2\u5343\u7C73\uFF0C\u76F8\u5BF9\u660E\u4EAE\u3002\n\n\u8FC7\u8FD1\u65E5\u70B9\u5F57\u53D1\u53EF\u8FDC\u5927\u4E8E\u6838\uFF1B\u53CC\u5C3E\u5728\u4E2D\u5C0F\u671B\u8FDC\u955C\u4E2D\u53EF\u89C1\u3002\n\n\u8FDC\u592A\u9633\u4E3A\u7D27\u51D1\u6697\u6591\u3002"
  descriptionVietnamese: "46P/Wirtanen l\xE0 sao ch\u1ED5i nh\u1ECF r\u1EA5t ho\u1EA1t
    \u0111\u1ED9ng, \u0111\xF4i khi r\u1EA5t g\u1EA7n Tr\xE1i \u0110\u1EA5t. H\u1EA1t
    nh\xE2n ~1,2 km.\n\nComa l\u1EDBn g\u1EA7n c\u1EADn nh\u1EADt; hai \u0111u\xF4i
    d\u1EC5 th\u1EA5y.\n\nXa M\u1EB7t Tr\u1EDDi l\xE0 v\u1EC7t m\u1EDD nh\u1ECF."
  descriptionUzbek: "46P/Wirtanen \u2014 kichik giperfaol komet, ba\u02BCzan Yerga
    juda yaqin. Yadro ~1,2 km.\n\nPerigeliyda katta koma va aniq ikki dum.\n\nUzoqda
    ixcham xira dog\u02BB."
