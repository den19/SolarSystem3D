--- !u!114 &2484400440785227108
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8191501088383274885}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_Borrelly
  labelKey: CometBorrellyLabel
  descriptionEnglish: "19P/Borrelly was imaged closely by Deep Space 1. Its nucleus
    is highly elongated (about 8\xD74\xD74 km) and extremely dark.\n\nNear the Sun
    jets of dust and gas build a bright coma and dual tails. The dust tail curves;
    the ion tail points rigidly antisunward.\n\nIn the outer solar system Borrelly
    shows only a faint nucleus with no tail."
  descriptionRussian: "19P/\u0411\u043E\u0440\u0440\u0435\u043B\u043B\u0438 \u0441\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C
    \u0441 \u0431\u043B\u0438\u0437\u043A\u043E\u0433\u043E \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043E\u043C Deep Space 1. \u042F\u0434\u0440\u043E
    \u0441\u0438\u043B\u044C\u043D\u043E \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u043E
    (\u043E\u043A\u043E\u043B\u043E 8\xD74\xD74 \u043A\u043C) \u0438 \u043A\u0440\u0430\u0439\u043D\u0435
    \u0442\u0451\u043C\u043D\u043E.\n\n\u0423 \u0421\u043E\u043B\u043D\u0446\u0430
    \u0441\u0442\u0440\u0443\u0438 \u043F\u044B\u043B\u0438 \u0438 \u0433\u0430\u0437\u0430
    \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u044F\u0440\u043A\u0443\u044E \u043A\u043E\u043C\u0443
    \u0438 \u0434\u0432\u0430 \u0445\u0432\u043E\u0441\u0442\u0430. \u041F\u044B\u043B\u0435\u0432\u043E\u0439
    \u0438\u0437\u043E\u0433\u043D\u0443\u0442; \u0438\u043E\u043D\u043D\u044B\u0439
    \u0441\u0442\u0440\u043E\u0433\u043E \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430.\n\n\u0412\u043E
    \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435
    \u2014 \u043B\u0438\u0448\u044C \u0442\u0443\u0441\u043A\u043B\u043E\u0435 \u044F\u0434\u0440\u043E
    \u0431\u0435\u0437 \u0445\u0432\u043E\u0441\u0442\u0430."
  descriptionChinese: "19P/\u535A\u96F7\u5229\u7531Deep Space 1\u8FD1\u8DDD\u79BB\u62CD\u6444\u3002\u6838\u6781\u5EA6\u62C9\u957F\uFF08\u7EA68\xD74\xD74\u5343\u7C73\uFF09\u4E14\u6781\u6697\u3002\n\n\u8FD1\u592A\u9633\u55B7\u6D41\u5F62\u6210\u4EAE\u5F57\u53D1\u4E0E\u53CC\u5C3E\uFF1B\u8FDC\u5916\u592A\u9633\u7CFB\u4EC5\u89C1\u6697\u6DE1\u6838\u3002"
  descriptionVietnamese: "19P/Borrelly \u0111\u01B0\u1EE3c Deep Space 1 ch\u1EE5p
    g\u1EA7n. H\u1EA1t nh\xE2n d\xE0i ~8\xD74\xD74 km, r\u1EA5t t\u1ED1i.\n\nG\u1EA7n
    M\u1EB7t Tr\u1EDDi c\xF3 coma s\xE1ng v\xE0 hai \u0111u\xF4i; xa ch\u1EC9 c\xF2n
    h\u1EA1t nh\xE2n m\u1EDD."
  descriptionUzbek: "19P/Borrelly \u2014 Deep Space 1 yaqin surati. 8\xD74\xD74 km
    cho\u02BBzilgan qorong\u02BBi yadro.\n\nQuyosh yaqinida yorqin koma; uzoqda dumsiz
    xira yadro."
--- !u!114 &1148197642766809683
