--- !u!114 &6196579088440879265
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6787858634192950937}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_Kopff
  labelKey: CometKopffLabel
  descriptionEnglish: '22P/Kopff is a dusty short-period comet with a period near
    6.4 years. Its nucleus is elongated and very dark, reflecting little sunlight.


    Approaching
    the Sun, a greenish coma swells and a dust tail arcs behind. An ion tail extends
    antisunward in pale violet-blue.


    In the cold outer solar system Kopff remains
    a barely visible speck.'
  descriptionRussian: "22P/\u041A\u043E\u043F\u0444\u0444 \u2014 \u043F\u044B\u043B\u0435\u0432\u0430\u044F
    \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u043E\u043C\u0435\u0442\u0430 \u0441 \u043F\u0435\u0440\u0438\u043E\u0434\u043E\u043C
    \u043E\u043A\u043E\u043B\u043E 6,4 \u0433\u043E\u0434\u0430. \u042F\u0434\u0440\u043E
    \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u043E\u0435, \u043E\u0447\u0435\u043D\u044C
    \u0442\u0451\u043C\u043D\u043E\u0435, \u043F\u043E\u0447\u0442\u0438 \u043D\u0435
    \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u0432\u0435\u0442.\n\n\u041F\u0440\u0438
    \u0441\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438 \u0441 \u0421\u043E\u043B\u043D\u0446\u0435\u043C
    \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u0430\u044F \u043A\u043E\u043C\u0430
    \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0442\u0441\u044F, \u043F\u044B\u043B\u0435\u0432\u043E\u0439
    \u0445\u0432\u043E\u0441\u0442 \u0434\u0443\u0433\u043E\u0439 \u0442\u044F\u043D\u0435\u0442\u0441\u044F
    \u0441\u0437\u0430\u0434\u0438, \u0438\u043E\u043D\u043D\u044B\u0439 \u2014 \u0433\u043E\u043B\u0443\u0431\u043E\u0432\u0430\u0442\u043E-\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439
    \u2014 \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430.\n\n\u0412 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439
    \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u0421\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u2014 \u0435\u0434\u0432\u0430 \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0435
    \u043F\u044F\u0442\u043D\u044B\u0448\u043A\u043E."
  descriptionChinese: "22P/\u79D1\u666E\u592B\u662F\u5468\u671F\u7EA66.4\u5E74\u7684\u5C18\u57C3\u5F57\u661F\uFF0C\u6838\u7EC6\u957F\u6781\u6697\u3002\n\n\u8FD1\u592A\u9633\u65F6\u7EFF\u8272\u5F57\u53D1\u81A8\u80C0\uFF0C\u5C18\u57C3\u5C3E\u6210\u5F27\uFF0C\u79BB\u5B50\u5C3E\u5448\u6DE1\u7D2B\u84DD\u8272\u80CC\u79BB\u592A\u9633\u3002\n\n\u5728\u5916\u592A\u9633\u7CFB\u4EC5\u4E3A\u52C9\u5F3A\u53EF\u89C1\u7684\u6697\u70B9\u3002"
  descriptionVietnamese: "22P/Kopff l\xE0 sao ch\u1ED5i b\u1EE5i, chu k\u1EF3 ~6,4
    n\u0103m, h\u1EA1t nh\xE2n t\u1ED1i v\xE0 d\xE0i.\n\nComa xanh v\xE0 hai \u0111u\xF4i
    g\u1EA7n M\u1EB7t Tr\u1EDDi; ngo\xE0i h\u1EC7 n\u1ED9i m\u1EDD nh\u1EA1t."
  descriptionUzbek: "22P/Kopff \u2014 changli komet, ~6,4 yil, cho\u02BBzilgan qorong\u02BBi
    yadro.\n\nYashil koma va ikki dum yaqinida; tashqarida deyarli ko\u02BBrinmas."
