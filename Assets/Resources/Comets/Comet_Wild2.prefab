--- !u!114 &1300359715072702128
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1081739315128324292}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_Wild2
  labelKey: CometWild2Label
  descriptionEnglish: '81P/Wild 2 is famous for its rugged, nearly spherical nucleus
    about 4 km wide, visited by NASA''s Stardust mission. The surface is dark, cratered,
    and icy.


    Solar heating drives a bright coma and dual tails: yellow dust
    swept along the orbit and a straight ion tail pointing from the Sun.


    Far
    from the Sun Wild 2 is a faint moving star with no visible coma or tail.'
  descriptionRussian: "81P/Wild 2 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430
    \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u043C \u043F\u043E\u0447\u0442\u0438
    \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u044F\u0434\u0440\u043E\u043C
    \u043E\u043A\u043E\u043B\u043E 4 \u043A\u043C \u2014 \u043A \u043D\u0435\u0439
    \u043B\u0435\u0442\u0430\u043B\u0430 \u043C\u0438\u0441\u0441\u0438\u044F Stardust.
    \u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0442\u0451\u043C\u043D\u0430\u044F,
    \u043A\u0440\u0430\u0442\u0435\u0440\u043D\u0430\u044F, \u043B\u0435\u0434\u044F\u043D\u0430\u044F.\n\n\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439
    \u043D\u0430\u0433\u0440\u0435\u0432 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
    \u044F\u0440\u043A\u0443\u044E \u043A\u043E\u043C\u0443 \u0438 \u0434\u0432\u0430
    \u0445\u0432\u043E\u0441\u0442\u0430: \u0436\u0451\u043B\u0442\u044B\u0439 \u043F\u044B\u043B\u0435\u0432\u043E\u0439
    \u0438 \u043F\u0440\u044F\u043C\u043E\u0439 \u0438\u043E\u043D\u043D\u044B\u0439
    \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430.\n\n\u0412\u0434\u0430\u043B\u0438
    \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430 \u2014 \u0441\u043B\u0430\u0431\u0430\u044F
    \u0434\u0432\u0438\u0436\u0443\u0449\u0430\u044F\u0441\u044F \u0437\u0432\u0435\u0437\u0434\u0430
    \u0431\u0435\u0437 \u043A\u043E\u043C\u044B \u0438 \u0445\u0432\u043E\u0441\u0442\u0430."
  descriptionChinese: "81P/\u7EF4\u5C14\u5FB72\u53F7\u4EE5\u7EA64\u5343\u7C73\u3001\u8FD1\u4E4E\u7403\u5F62\u7684\u5D0E\u5C96\u6838\u95FB\u540D\uFF0C\u66FE\u7531Stardust\u63A2\u6D4B\u5668\u53D6\u6837\u3002\u8868\u9762\u6697\u3001\u591A\u5751\u3001\u542B\u51B0\u3002\n\n\u8FD1\u592A\u9633\u5F62\u6210\u4EAE\u5F57\u53D1\u4E0E\u53CC\u5C3E\uFF1B\u8FDC\u592A\u9633\u4EC5\u4E3A\u65E0\u5F57\u53D1\u7684\u6697\u5F31\u79FB\u52A8\u661F\u70B9\u3002"
  descriptionVietnamese: "81P/Wild 2 c\xF3 h\u1EA1t nh\xE2n g\u1EA7n c\u1EA7u ~4
    km, t\u1EEBng \u0111\u01B0\u1EE3c Stardust th\u0103m d\xF2.\n\nComa s\xE1ng v\xE0
    hai \u0111u\xF4i g\u1EA7n M\u1EB7t Tr\u1EDDi; xa ch\u1EC9 l\xE0 sao m\u1EDD di
    chuy\u1EC3n."
  descriptionUzbek: "81P/Wild 2 \u2014 taxminan 4 km deyarli sferik yadro, Stardust
    missiyasi tashrifi.\n\nQuyosh yaqinida yorqin koma va ikki dum; uzoqda xira harakatlanuvchi
    yulduz."
