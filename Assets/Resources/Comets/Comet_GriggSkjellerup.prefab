--- !u!114 &3118760693196371275
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4828946298258268624}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65e7039f0ee756241a07395235c86c07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CometInfo
  cometId: Comet_GriggSkjellerup
  labelKey: CometGriggSkjellerupLabel
  descriptionEnglish: "26P/Grigg\u2013Skjellerup is a faint periodic comet with a
    period near 5.1 years and a steeply inclined orbit. Its small nucleus is dark
    and elongated.\n\nEven at moderate solar distances a modest coma and short dust
    tail may appear. The ion tail is thin and blue, always oriented away from the
    Sun.\n\nFar from the Sun it is one of the faintest periodic comets in the catalog."
  descriptionRussian: "26P/\u0413\u0440\u0438\u0433\u0433\u2014\u0421\u043A\u044C\u0435\u043B\u043B\u0435\u0440\u0443\u043F
    \u2014 \u0441\u043B\u0430\u0431\u0430\u044F \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043A\u043E\u043C\u0435\u0442\u0430 \u0441 \u043F\u0435\u0440\u0438\u043E\u0434\u043E\u043C
    \u043E\u043A\u043E\u043B\u043E 5,1 \u0433\u043E\u0434\u0430 \u0438 \u0441\u0438\u043B\u044C\u043D\u043E
    \u043D\u0430\u043A\u043B\u043E\u043D\u0451\u043D\u043D\u043E\u0439 \u043E\u0440\u0431\u0438\u0442\u043E\u0439.
    \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435 \u044F\u0434\u0440\u043E
    \u0442\u0451\u043C\u043D\u043E\u0435 \u0438 \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u043E\u0435.\n\n\u0423\u043C\u0435\u0440\u0435\u043D\u043D\u0430\u044F
    \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u0430\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F
    \u0434\u0430\u0451\u0442 \u0441\u043A\u0440\u043E\u043C\u043D\u0443\u044E \u043A\u043E\u043C\u0443
    \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u044B\u043B\u0435\u0432\u043E\u0439
    \u0445\u0432\u043E\u0441\u0442. \u0418\u043E\u043D\u043D\u044B\u0439 \u0445\u0432\u043E\u0441\u0442
    \u0442\u043E\u043D\u043A\u0438\u0439, \u0433\u043E\u043B\u0443\u0431\u043E\u0439,
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430.\n\n\u0412\u0434\u0430\u043B\u0438
    \u043E\u0442 \u0421\u043E\u043B\u043D\u0446\u0430 \u2014 \u043E\u0434\u043D\u0430
    \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0442\u0443\u0441\u043A\u043B\u044B\u0445
    \u043A\u043E\u043C\u0435\u0442 \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u0430."
  descriptionChinese: "26P/\u683C\u91CC\u683C\u2014\u65AF\u57FA\u52D2\u9C81\u666E\u5468\u671F\u7EA65.1\u5E74\uFF0C\u8F68\u9053\u503E\u89D2\u5927\uFF0C\u6838\u5C0F\u800C\u6697\u957F\u3002\n\n\u4E2D\u7B49\u65E5\u8DDD\u53EF\u51FA\u73B0\u5F31\u5F57\u53D1\u4E0E\u77ED\u5C18\u5C3E\uFF1B\u79BB\u5B50\u5C3E\u7EC6\u800C\u84DD\u3002\n\n\u8FDC\u592A\u9633\u65F6\u6781\u4E3A\u6697\u6DE1\u3002"
  descriptionVietnamese: "26P/Grigg\u2013Skjellerup chu k\u1EF3 ~5,1 n\u0103m, qu\u1EF9
    \u0111\u1EA1o nghi\xEAng, h\u1EA1t nh\xE2n nh\u1ECF t\u1ED1i.\n\nComa v\xE0 \u0111u\xF4i
    ng\u1EAFn v\u1EEBa ph\u1EA3i; \u0111u\xF4i ion m\u1ECFng xanh.\n\nR\u1EA5t m\u1EDD
    khi xa M\u1EB7t Tr\u1EDDi."
  descriptionUzbek: "26P/Grigg\u2013Skjellerup \u2014 ~5,1 yil, qiya orbita, kichik
    qorong\u02BBi yadro.\n\nO\u02BBrtacha masofada zaif koma; uzoqda juda xira."
