  m_Script: {fileID: 11500000, guid: 626ec590095011349ad7d8c0af992510, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AsteroidInfo
  asteroidId: Asteroid_Icarus
  labelKey: AsteroidIcarusLabel
  descriptionEnglish: "1566 Icarus is a near-Earth Apollo asteroid whose perihelion
    dips inside Mercury's orbit. Close approaches to the Sun heat its surface \u2014
    used here to show the hot asteroid-ball material variant."
  descriptionRussian: "1566 \u0418\u043A\u0430\u0440 \u2014 \u043E\u043A\u043E\u043B\u043E\u0437\u0435\u043C\u043D\u044B\u0439
    \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434 \u0433\u0440\u0443\u043F\u043F\u044B
    \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430; \u043F\u0435\u0440\u0438\u0433\u0435\u043B\u0438\u0439
    \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u0432\u043D\u0443\u0442\u0440\u044C
    \u043E\u0440\u0431\u0438\u0442\u044B \u041C\u0435\u0440\u043A\u0443\u0440\u0438\u044F.
    \u0421\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u044F \u0441 \u0421\u043E\u043B\u043D\u0446\u0435\u043C
    \u0441\u0438\u043B\u044C\u043D\u043E \u043D\u0430\u0433\u0440\u0435\u0432\u0430\u044E\u0442
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u2014 \u0437\u0434\u0435\u0441\u044C
    \u044D\u0442\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \xAB\u0433\u043E\u0440\u044F\u0447\u0438\u0439\xBB \u0432\u0430\u0440\u0438\u0430\u043D\u0442
    \u043C\u043E\u0434\u0435\u043B\u0438."
  descriptionChinese: "1566\u4F0A\u5361\u6D1B\u65AF\u662F\u963F\u6CE2\u7F57\u578B\u8FD1\u5730\u5C0F\u884C\u661F\uFF0C\u8FD1\u65E5\u70B9\u8FDB\u5165\u6C34\u661F\u8F68\u9053\u5185\u4FA7\uFF1B\u8FD1\u65E5\u52A0\u70ED\u5BF9\u5E94\u672C\u5E94\u7528\u7684\u201C\u70ED\u201D\u6750\u8D28\u53D8\u4F53\u3002"
  descriptionVietnamese: "1566 Icarus l\xE0 ti\u1EC3u h\xE0nh tinh Apollo c\u1EADn
    Tr\xE1i \u0110\u1EA5t; \u0111i\u1EC3m c\u1EADn nh\u1EADt n\u1EB1m trong qu\u1EF9
    \u0111\u1EA1o Sao Th\u1EE7y \u2014 d\xF9ng \u0111\u1EC3 hi\u1EC7n bi\u1EBFn th\u1EC3
    v\u1EADt li\u1EC7u n\xF3ng."
  descriptionUzbek: "1566 Icarus \u2014 Yer yaqinidagi Apollon tipidagi asteroid;
    periheliy Merkuriy orbitasidan ichkariga kiradi."
  descriptionTatar: "1566 \u0418\u043A\u0430\u0440 \u2014 \u0496\u0438\u0440 \u044F\u043D\u044B\u043D\u0434\u0430\u0433\u044B
    \u0410\u043F\u043E\u043B\u043B\u043E\u043D \u0442\u04E9\u0440\u0435\u043D\u0434\u04D9\u0433\u0435
    \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434; \u043F\u0435\u0440\u0438\u0433\u0435\u043B\u0438\u0439
    \u041C\u0435\u0440\u043A\u0443\u0440\u0438\u0439 \u043E\u0440\u0431\u0438\u0442\u0430\u0441\u044B\u043D\u043D\u0430\u043D
    \u044D\u0447\u043A\u04D9 \u043A\u0435\u0440\u04D9."
  descriptionBelarusian: "1566 \u0406\u043A\u0430\u0440 \u2014 \u043A\u0430\u043B\u044F\u0437\u044F\u043C\u043D\u044B
    \u0430\u0441\u0442\u044D\u0440\u043E\u0456\u0434 \u0433\u0440\u0443\u043F\u044B
    \u0410\u043F\u0430\u043B\u043E\u043D\u0430; \u043F\u0435\u0440\u044B\u0433\u0435\u043B\u0456\u0439
    \u0437\u0430\u0445\u043E\u0434\u0437\u0456\u0446\u044C \u0443\u043D\u0443\u0442\u0440
    \u0430\u0440\u0431\u0456\u0442\u044B \u041C\u0435\u0440\u043A\u0443\u0440\u044B\u044F."
