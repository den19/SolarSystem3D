  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 626ec590095011349ad7d8c0af992510, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AsteroidInfo
  asteroidId: Asteroid_Pallas
  labelKey: AsteroidPallasLabel
  descriptionEnglish: "Pallas is one of the largest asteroids and has an unusually
    high orbital inclination (~35\xB0). Its orbit and spectrum make it a distinctive
    member of the main belt."
  descriptionRussian: "\u041F\u0430\u043B\u043B\u0430\u0434\u0430 \u2014 \u043E\u0434\u0438\u043D
    \u0438\u0437 \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0445 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043E\u0432
    \u0441 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u043C
    \u043D\u0430\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435\u043C \u043E\u0440\u0431\u0438\u0442\u044B
    (~35\xB0). \u041F\u043E \u043E\u0440\u0431\u0438\u0442\u0435 \u0438 \u0441\u043F\u0435\u043A\u0442\u0440\u0443
    \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442
    \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u043F\u043E\u044F\u0441\u0430."
  descriptionChinese: "\u667A\u795E\u661F\u662F\u6700\u5927\u7684\u5C0F\u884C\u661F\u4E4B\u4E00\uFF0C\u8F68\u9053\u503E\u89D2\u5F02\u5E38\u9AD8\uFF08\u7EA635\xB0\uFF09\uFF0C\u662F\u4E3B\u5E26\u4E2D\u72EC\u7279\u7684\u6210\u5458\u3002"
  descriptionVietnamese: "Pallas l\xE0 m\u1ED9t trong nh\u1EEFng ti\u1EC3u h\xE0nh
    tinh l\u1EDBn nh\u1EA5t, \u0111\u1ED9 nghi\xEAng qu\u1EF9 \u0111\u1EA1o cao (~35\xB0)
    \u2014 th\xE0nh vi\xEAn \u0111\u1EB7c bi\u1EC7t c\u1EE7a v\xE0nh \u0111ai ch\xEDnh."
  descriptionUzbek: "Pallas \u2014 eng yirik asteroidlardan biri, orbital egilishi
    juda katta (~35\xB0)."
  descriptionTatar: "\u041F\u0430\u043B\u043B\u0430\u0434\u0430 \u2014 \u0438\u04A3
    \u0437\u0443\u0440 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u043B\u0430\u0440\u0434\u0430\u043D
    \u0431\u0435\u0440\u0441\u0435, \u043E\u0440\u0431\u0438\u0442\u0430 \u0430\u0432\u044B\u0448\u043B\u044B\u0433\u044B
    \u0433\u0430\u0434\u04D9\u0442\u0442\u04D9\u043D \u0442\u044B\u0448 \u0437\u0443\u0440
    (~35\xB0)."
  descriptionBelarusian: "\u041F\u0430\u043B\u0430\u0434\u0430 \u2014 \u0430\u0434\u0437\u0456\u043D
    \u0437 \u043D\u0430\u0439\u0431\u0443\u0439\u043D\u0435\u0439\u0448\u044B\u0445
    \u0430\u0441\u0442\u044D\u0440\u043E\u0456\u0434\u0430\u045E \u0437 \u0432\u044F\u043B\u0456\u043A\u0456\u043C
    \u043D\u0430\u0445\u0456\u043B\u0430\u043C \u0430\u0440\u0431\u0456\u0442\u044B
    (~35\xB0)."
